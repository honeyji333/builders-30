# =============================================================================
# KageStream - Environment Configuration Template
# Day 14 Deliverable: Secrets Management & Hosting Configuration (#ALTABuilder30)
# =============================================================================

# Server Environment & Port
PORT=3000
NODE_ENV=production

# Database Configuration (Relative to root or persistent volume path)
DATABASE_PATH=./data/anime.db

# Authentication & Security Secrets
# In production, set this to a random 64-character hex string (e.g., openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_alta_builder_30

# CORS & Domain Settings
CORS_ORIGIN=*
PUBLIC_SITE_URL=http://localhost:3000
